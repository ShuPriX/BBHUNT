/tmp-lab/
*.apk
*.ipa
*.zip
*.tar.gz
*.war
*.jar

# ── python ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── editor / OS ─────────────────────────────────────────────────────
.DS_Store
*.swp
*~
.idea/
.vscode/
